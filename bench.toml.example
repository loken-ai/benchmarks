# What a campaign measures with. Copy this file to bench.toml and fill it in.
# A relative path is read from the directory of this file.

[loken]
# The lokend of a loken release, for example the one unpacked from the release archive.
binary = "loken/lokend"
# The directory whose config.toml lokend is started with. That file also names the model
# stores (ollama_models_dir, huggingface_models_dir) the peer engines read.
config_dir = "loken"
# Where lokend answers.
url = "http://127.0.0.1:11435"

[lokprof]
# The lokprof of a lokprof release.
binary = "lokprof/lokprof"
