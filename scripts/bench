#!/usr/bin/env bash
# The one entry point for a reproducible loken bench campaign.
#
# It owns nothing the stores already know: the model list comes from loken's own catalogue
# (GET /api/tags), the store paths from the config.toml loken is started with, and the matrix
# axes from matrix.toml. The binaries it measures with, a release of loken and a release of
# lokprof, are named in bench.toml (copy bench.toml.example). There is no model list to maintain
# and no machine path in the repository.
#
# Usage:
#   bench                 # PLAN: print the cells a campaign would run (no side effects) [default]
#   bench --plan          # same, explicit
#   BENCH_ONLY="a b" bench run   # RUN only the named models
#   BACKEND=vulkan bench run     # measure the card through Vulkan (opencl: loken alone)
#   bench run             # RUN the campaign (provisions engines, measures) - see `run` below
#
# `run` is deliberately not the default: it installs pinned ollama/vLLM into a bench-only
# compartment and drives the full matrix, which monopolizes the machine. Plan first, run on purpose.
set -u

if [ "${1:-}" = -h ] || [ "${1:-}" = --help ]; then sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0; fi

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"   # scripts
ROOT="$(cd "$HERE/.." && pwd)"                            # this repository
SETTINGS="$ROOT/bench.toml"
MATRIX="$ROOT/matrix.toml"
# The golden recording an ASR cell transcribes and the transcript its word error rate is read
# against. Either can be pointed elsewhere for a one-off run.
ASR_AUDIO="${ASR_AUDIO:-$ROOT/fixtures/asr/jfk.wav}"
ASR_REFERENCE="${ASR_REFERENCE:-$ROOT/fixtures/asr/jfk.txt}"
# Whose cards a campaign measures: every card of the machine. On a machine with NVIDIA and AMD
# cards that is GPU_VENDOR=all, loken driving both vendors at once; GPU_VENDOR=nvidia or amd
# restricts the run to one vendor and hides the other's cards from every engine.
if [ -z "${GPU_VENDOR:-}" ]; then
    has_nvidia=0; has_amd=0
    nvidia-smi -L 2>/dev/null | grep -q . && has_nvidia=1
    grep -qs 0x1002 /sys/bus/pci/devices/*/vendor && has_amd=1
    if [ "$has_nvidia" = 1 ] && [ "$has_amd" = 1 ]; then GPU_VENDOR=all
    elif [ "$has_amd" = 1 ]; then GPU_VENDOR=amd
    else GPU_VENDOR=nvidia; fi
fi
export GPU_VENDOR
# The runtime a campaign measures a card through: its native one (default), its Vulkan device
# (loken and ollama both on Vulkan), or OpenCL (loken alone). VULKAN_CARD names the card by a
# part of its name when the vendor's default is not the one.
BACKEND="${BACKEND:-native}"
case "$BACKEND" in
    native|vulkan|opencl) ;;
    *) echo "bench: BACKEND must be native, vulkan or opencl, not '$BACKEND'" >&2; exit 1 ;;
esac
export BACKEND
die() { echo "bench: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

have python3 || die "python3 is required (TOML parsing, list handling)"
have curl || die "curl is required (loken catalogue)"
[ -f "$SETTINGS" ] || die "no bench.toml at $SETTINGS (copy bench.toml.example and fill it in)"
[ -f "$MATRIX" ] || die "no matrix at $MATRIX"

# --- bench.toml: the builds measured and where loken is started ----------------------------------
# A relative path is read from the directory of bench.toml.
setting() { # setting <table.key>
    python3 - "$SETTINGS" "$1" <<'PY'
import pathlib, sys, tomllib
path = pathlib.Path(sys.argv[1])
cur = tomllib.loads(path.read_text())
for part in sys.argv[2].split("."):
    cur = cur.get(part, {}) if isinstance(cur, dict) else {}
if isinstance(cur, str) and cur:
    where = pathlib.Path(cur)
    print(cur if "://" in cur else where if where.is_absolute() else (path.parent / where).resolve())
else:
    print("")
PY
}
# The ssh targets of the other nodes when the campaign measures a cluster, one per line.
cluster_nodes() {
    python3 - "$SETTINGS" <<'PY'
import pathlib, sys, tomllib
for node in tomllib.loads(pathlib.Path(sys.argv[1]).read_text()).get("cluster", {}).get("nodes", []):
    print(node)
PY
}
# The loken build measured, the directory whose config.toml it is started with, and its address.
LOKEN_BIN="$(setting loken.binary)"
LOKEN_CWD="$(setting loken.config_dir)"
LOKEN_URL="$(setting loken.url)"
LOKPROF="$(setting lokprof.binary)"
[ -n "$LOKEN_URL" ] || LOKEN_URL="http://127.0.0.1:11435"
[ -x "$LOKEN_BIN" ] || die "bench.toml: loken.binary '$LOKEN_BIN' is not an executable (a lokend from a loken release)"
[ -x "$LOKPROF" ] || die "bench.toml: lokprof.binary '$LOKPROF' is not an executable (the lokprof of a lokprof release)"
[ -f "$LOKEN_CWD/config.toml" ] || die "bench.toml: loken.config_dir '$LOKEN_CWD' holds no config.toml"
export LOKEN_BIN LOKEN_CWD LOKPROF
CONFIG="$LOKEN_CWD/config.toml"

# --- loken's config.toml: the single source of the store paths ---------------------------------
cfg_key() { # cfg_key <dotted.key>
    python3 - "$CONFIG" "$1" <<'PY'
import sys, tomllib
cfg = tomllib.load(open(sys.argv[1], "rb"))
cur = cfg
for part in sys.argv[2].split("."):
    cur = cur.get(part, {}) if isinstance(cur, dict) else {}
print(cur if isinstance(cur, str) else "")
PY
}

OLLAMA_STORE="$(cfg_key ollama_models_dir)"
HF_STORE="$(cfg_key huggingface_models_dir)"
[ -n "$OLLAMA_STORE" ] || die "$CONFIG has no ollama_models_dir"
# The engines read the same store loken does - this is what ends the split-brain.
export OLLAMA_MODELS="$OLLAMA_STORE"
export MODELS_DIR="$OLLAMA_STORE"
[ -n "$HF_STORE" ] && export HF_HOME="$HF_STORE"

# --- the model list = loken's catalogue, with the modality AND the format loken declares --------
# loken's /api/tags entries carry, per model, `capabilities` (completion, tts,
# asr, txt2img/img2img, music, ...) and `details.format` ("gguf" for an ollama-source model,
# "safetensors" for a huggingface-source one - set at models.rs:71-81 from the model's source). Both
# are read from THERE, never guessed from the name: the modality picks lokprof's clock, the format says
# which peer engine can load the weights (gguf->ollama, safetensors->vLLM; loken serves both).
# Emits "name<TAB>modality<TAB>format" per model.
loken_models() {
    curl -sf "$LOKEN_URL/api/tags" | python3 -c '
import sys, json
def modality(caps):
    caps = set(caps or [])
    if "vision" in caps: return "vision"
    if caps & {"txt2img", "img2img", "edit"}: return "image"
    if caps & {"music", "sfx"}: return "music"   # /v1/audio/generations: prompt in, audio out
    if "tts" in caps: return "tts"
    if "asr" in caps: return "asr"
    if "completion" in caps: return "text"
    if not caps: return "unserved"   # listed from the store, no engine in this build serves it
    return sorted(caps)[0]           # embedding, video, midi...: no lokprof clock, an error cell
for m in json.load(sys.stdin).get("models", []):
    fmt = (m.get("details") or {}).get("format") or ""
    print(m["name"] + "\t" + modality(m.get("capabilities")) + "\t" + fmt)
' 2>/dev/null
}

# loken must answer for the catalogue. When it does not, start the lokend named in bench.toml with
# its configuration and wait for it; the campaign's own runs stop and start their servers anyway.
STARTED=""
trap '[ -n "$STARTED" ] && kill "$STARTED" 2>/dev/null' EXIT
ensure_catalogue() {
    curl -sf -m 5 "$LOKEN_URL/api/tags" >/dev/null && return 0
    mkdir -p "$ROOT/results"
    (cd "$LOKEN_CWD" && exec "$LOKEN_BIN" serve) >"$ROOT/results/lokend-catalogue.log" 2>&1 &
    STARTED=$!
    local waited=0
    until curl -sf -m 5 "$LOKEN_URL/api/tags" >/dev/null; do
        [ "$waited" -lt 120 ] || die "lokend did not answer at $LOKEN_URL (see results/lokend-catalogue.log)"
        kill -0 "$STARTED" 2>/dev/null || die "lokend stopped at start (see results/lokend-catalogue.log)"
        sleep 1; waited=$((waited + 1))
    done
}

# The context window a model declares, in tokens, from the metadata loken shows for it; nothing
# when the metadata states none (a checkpoint, a media model). A cell asking for more than a model
# declares is skipped, never measured past the window.
declare -A DECLARED_CTX=()
model_context() { # model_context <model>
    if [ -z "${DECLARED_CTX[$1]+set}" ]; then
        DECLARED_CTX[$1]="$(curl -sf -m 30 -X POST "$LOKEN_URL/api/show" -d "{\"name\":\"$1\"}" \
            | python3 -c '
import sys, json
info = json.load(sys.stdin).get("model_info") or {}
sizes = [v for k, v in info.items() if k.endswith(".context_length") and isinstance(v, int)]
print(max(sizes) if sizes else "")' 2>/dev/null)"
    fi
    printf '%s' "${DECLARED_CTX[$1]}"
}

# The engines that can serve one cell, and how lokprof must run it, from the modality and the format.
# One rule, no name heuristic, no curated peer list: the format loken declares says which peer can
# load the weights; the modality says which clock and whether a peer speaks that endpoint at all.
# Emits "engines<TAB>lokprof-modality<TAB>vllm-serve<TAB>error" (error non-empty => an error cell).
plan_cell() { # plan_cell <model> <modality> <format>
    local m="$1" mod="$2" fmt="$3"
    local engines="loken" amod="$mod" vserve="" err=""
    case "$mod" in
        text|vision)
            case "$fmt" in
                gguf)        engines="ollama loken" ;;
                safetensors) engines="loken vllm"; vserve="hf:$m --name $m" ;;
                *)           err="unknown format '${fmt:-<none>}' (neither gguf nor safetensors)" ;;
            esac ;;
        image|music|tts)
            engines="loken" ;;   # only loken speaks images/generations, audio/speech here
        asr)
            if ! [ -s "$ASR_AUDIO" ]; then
                err="asr needs a golden audio (no file at $ASR_AUDIO)"
            elif [ "$fmt" = safetensors ]; then
                # vLLM serves the same checkpoint on /v1/audio/transcriptions, its context held
                # to the decoder's own length.
                engines="loken vllm"; vserve="hf:$m --name $m$(decoder_len_arg "$m")"
            else
                engines="loken"
            fi ;;
        unserved)
            err="not served by loken: it declares no capability" ;;
        *)  err="no lokprof measurement for the '$mod' capability" ;;
    esac
    # "|" separates the fields, not a tab: a tab is IFS whitespace, so an empty middle field (an
    # empty vLLM target) would collapse and shift the error into the wrong column. No field holds a
    # "|".
    printf '%s|%s|%s|%s\n' "$engines" "$amod" "$vserve" "$err"
}

# " --max-len <n>" from the decoder length a Hugging Face checkpoint declares in the store, or
# nothing when the store does not hold its configuration.
decoder_len_arg() { # decoder_len_arg <repo>
    local cfg
    cfg="$(ls -d "${HF_HOME:-}"/hub/models--"${1//\//--}"/snapshots/*/config.json 2>/dev/null | head -1)"
    [ -n "$cfg" ] || return 0
    python3 -c '
import json, sys
c = json.load(open(sys.argv[1]))
n = c.get("max_target_positions") or c.get("max_position_embeddings")
print(f" --max-len {n}" if isinstance(n, int) else "", end="")' "$cfg"
}

# Write a visible ERROR cell for a model loken lists but the campaign cannot measure, so it appears
# in the report as impossible (bench_row reads load_error) instead of silently vanishing.
write_error_cell() { # write_error_cell <model> <reason> <out> <stamp>
    python3 - "$1" "$2" "$3" "$4" <<'PY'
import json, sys, datetime
model, reason, out, stamp = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
doc = {
    "schema": "loken/2",
    "engine_build": stamp,
    "timestamp": datetime.datetime.now().astimezone().isoformat(),
    "results": [{
        "target": "loken", "url": "", "model": model, "num_ctx": 4096, "prompt": "short",
        "prompt_chars": 0, "stats": {}, "iterations": [], "iteration_errors": [],
        "coherence_pass": None, "first_response_preview": "", "load_time_ms": None,
        "model_fingerprint": None, "load_error": reason,
    }],
}
json.dump(doc, open(out, "w"))
PY
}

# Stamp a freshly measured result with the binary build and the versions of the engines that
# actually produced a row in it. The report reads the version from here, so a row never carries the
# version installed when the report was generated - only the one it was measured with.
stamp_result() { # stamp_result <file> <stamp>
    python3 - "$1" "$2" "${OLLAMA_VER:-}" "${VLLM_VER:-}" <<'PY'
import json, sys
p, stamp, over, vver = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4]
d = json.load(open(p))
d["engine_build"] = stamp
targets = {r.get("target", "").lower() for r in d.get("results", [])}
if over and "ollama" in targets:
    d["ollama_version"] = over
if vver and "vllm" in targets:
    d["vllm_version"] = vver
json.dump(d, open(p, "w"))
PY
}

# True when a result file can be kept on resume: measured by the CURRENT binary AND, for each engine
# that produced a row, the CURRENT version of that engine. Change ollama or vLLM and the cells they
# measured are re-run, not relabelled - a version is never claimed for a bench not run with it.
cell_current() { # cell_current <file> <stamp>
    python3 - "$1" "$2" "${OLLAMA_VER:-}" "${VLLM_VER:-}" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
stamp, over, vver = int(sys.argv[2]), sys.argv[3], sys.argv[4]
if d.get("engine_build") != stamp:
    sys.exit(1)
targets = {r.get("target", "").lower() for r in d.get("results", [])}
if "ollama" in targets and str(d.get("ollama_version") or "") != over:
    sys.exit(1)
if "vllm" in targets and str(d.get("vllm_version") or "") != vver:
    sys.exit(1)
sys.exit(0)
PY
}

# --- plan: print the cells a campaign would run, no side effects -------------------------------
plan() {
    echo "store (ollama):  $OLLAMA_STORE"
    echo "store (hf):      ${HF_STORE:-<none>}"
    echo "loken:           $LOKEN_URL"
    local models
    ensure_catalogue
    models="$(loken_models)"
    [ -n "$models" ] || die "loken returned no catalogue at $LOKEN_URL/api/tags (is it serving?)"
    local n_models
    n_models=$(printf '%s\n' "$models" | grep -c .)
    echo "models:          $n_models (from loken)"
    echo
    printf '%-40s  %-8s  %-12s  %-16s  %s\n' "model" "modality" "format" "engines" "note"
    printf '%-40s  %-8s  %-12s  %-16s  %s\n' "----------------------------------------" "--------" "------------" "----------------" "----"
    local m mod fmt engines amod vserve err
    while IFS=$'\t' read -r m mod fmt; do
        [ -n "$m" ] || continue
        # BENCH_ONLY: space-separated model names; only those cells run.
        if [ -n "${BENCH_ONLY:-}" ] && ! [[ " $BENCH_ONLY " == *" $m "* ]]; then continue; fi
        IFS='|' read -r engines amod vserve err < <(plan_cell "$m" "$mod" "$fmt")
        printf '%-40s  %-8s  %-12s  %-16s  %s\n' \
            "$m" "$mod" "${fmt:-<none>}" "${err:+ERROR}${err:-$engines}" "$err"
    done <<< "$models"
    echo
    echo "context sizes (FULL=1): $(python3 -c 'import sys, tomllib; print(*tomllib.load(open(sys.argv[1], "rb"))["axes"]["context"])' "$MATRIX")"
    echo "a context above a model's declared window is skipped"
    echo "(plan only; run with: $0 run)"
}

# --- provision the bench-only engine compartment (never ~/vllm, never the PATH) ----------------
# A fresh uv venv for vLLM and the latest ollama release, both under the bench working tree, so the
# comparison runs against current engines without touching any other environment. Versions printed.
provision() {
    # loken alone is measured on OpenCL: no peer engine is fetched or run.
    if [ "$BACKEND" = opencl ]; then
        echo "engines: none provisioned (backend opencl measures loken alone)"
        export OLLAMA_VER="" VLLM_VER=""
        return 0
    fi
    have uv || die "uv is required to provision the vLLM venv"
    have tar || die "tar is required to provision ollama"
    local comp="$ROOT/results/engines"
    mkdir -p "$comp"
    local venv="$comp/vllm-venv"
    # The download cache stays in the compartment too, on the same disk as the venv it feeds.
    export UV_CACHE_DIR="$comp/uv-cache"
    if [ ! -x "$venv/bin/vllm" ]; then
        echo "provisioning vLLM into $venv (uv pip install vllm)..."
        uv venv "$venv" >&2 || die "uv venv failed"
        uv pip install --python "$venv/bin/python" "vllm[audio]" >&2 || die "vllm install failed"
    fi
    # The audio extra serves the transcription route; a venv provisioned without it gets it at
    # the vLLM version it already holds.
    if ! "$venv/bin/python" -c 'import librosa, soundfile' 2>/dev/null; then
        local held
        held="$("$venv/bin/python" -c 'import vllm;print(vllm.__version__)' 2>/dev/null | tail -1)"
        uv pip install --python "$venv/bin/python" "vllm[audio]==$held" >&2 \
            || die "vllm audio extra install failed"
    fi
    export VLLM_VENV="$venv"
    have zstd || die "zstd is required to unpack the ollama release (.tar.zst)"
    local obin
    obin="$(ls -d "$comp"/ollama-*/bin/ollama 2>/dev/null | sort -V | tail -1)"
    if [ -z "$obin" ]; then
        # Read the version and the real asset URL from the release API: ollama now ships the plain
        # linux amd64 build as ollama-linux-amd64.tar.zst (no .tgz, no -rocm/-mlx). Reading the URL
        # rather than constructing it self-heals if the naming shifts again.
        local ver url dir arc
        read -r ver url < <(ollama_asset ollama-linux-amd64.tar.zst)
        [ -n "$ver" ] && [ -n "$url" ] || die "cannot resolve latest ollama linux amd64 asset"
        dir="$comp/ollama-$ver"; arc="$comp/ollama-$ver.tar.zst"; mkdir -p "$dir"
        echo "provisioning ollama $ver into $dir..."
        curl -fL "$url" -o "$arc" || die "ollama download failed"
        tar -C "$dir" --zstd -xf "$arc" || die "ollama unpack failed"
        rm -f "$arc"
        obin="$dir/bin/ollama"
    fi
    [ -x "$obin" ] || die "no ollama binary in the compartment"
    # AMD cards need ollama's ROCm libraries, shipped apart and unpacked over the same tree.
    local odir; odir="$(dirname "$(dirname "$obin")")"
    if { [ "$GPU_VENDOR" = amd ] || [ "$GPU_VENDOR" = all ]; } && grep -qs 0x1002 /sys/bus/pci/devices/*/vendor \
            && ! compgen -G "$odir/lib/ollama/rocm*" >/dev/null; then
        local over rurl rarc
        over="$("$obin" --version 2>&1 | grep -oiE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
        read -r _ rurl < <(ollama_asset ollama-linux-amd64-rocm.tar.zst "v$over")
        [ -n "$rurl" ] || die "cannot resolve the ollama $over ROCm asset"
        rarc="$odir.rocm.tar.zst"
        echo "provisioning ollama $over ROCm libraries into $odir..."
        curl -fL "$rurl" -o "$rarc" || die "ollama ROCm download failed"
        tar -C "$odir" --zstd -xf "$rarc" || die "ollama ROCm unpack failed"
        rm -f "$rarc"
    fi
    export OLLAMA_BIN="$obin"
    # The versions each engine will be measured with. Stamped into every result file so the report
    # reads the version from the measurement, not from whatever is installed when it is generated.
    OLLAMA_VER="$("$OLLAMA_BIN" --version 2>&1 | grep -oiE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
    VLLM_VER="$("$venv/bin/python" -c 'import vllm;print(vllm.__version__)' 2>/dev/null | tail -1)"
    export OLLAMA_VER VLLM_VER
    echo "engines (bench compartment):"
    echo "  ollama:  ${OLLAMA_VER:-?}  [$OLLAMA_BIN]"
    echo "  vLLM:    ${VLLM_VER:-?}  [$venv]"
}

# "<version> <url>" of the ollama release asset named $1, from release $2 or the latest one.
# Read from the release API rather than constructed, so a renamed asset is found, not guessed.
ollama_asset() { # ollama_asset <asset> [tag]
    local release=latest
    [ -n "${2:-}" ] && release="tags/$2"
    curl -sf "https://api.github.com/repos/ollama/ollama/releases/$release" | python3 -c '
import sys, json
r = json.load(sys.stdin)
url = next((a["browser_download_url"] for a in r["assets"] if a["name"] == sys.argv[1]), "")
print(r["tag_name"].lstrip("v"), url)' "$1"
}

# --- run: sweep the matrix through the existing isolation protocol -----------------------------
# The measurement protocol (kill peers, thermal floor, per-engine invoke, merge) lives in
# fair-run.sh and is reused unchanged; this only names the cells from the catalogue + manifest and
# stamps/reports each. It provisions the bench engine compartment first (ollama + vLLM, never
# ~/vllm), so text cells run loken vs ollama vs vLLM from the start. Without FULL=1 it is a fast
# pass: GPU, ctx 4096, the short prompt, streaming. FULL=1 sweeps the whole matrix the way the
# campaigns of August and September did: for each device, context, prompt and streaming mode in
# that order, every model once, one fair-run per cell and per prompt, the CPU sweeps streamed
# only. A generated-media cell has no such axes and is measured once, in the first sweep.
run() {
    provision
    local models
    ensure_catalogue
    models="$(loken_models)"
    # Each declared window is read now, while loken answers: the first cell stops that server.
    local name kind
    while IFS=$'\t' read -r name kind _; do
        case "$kind" in text|vision) model_context "$name" >/dev/null ;; esac
    done <<< "$models"
    [ -n "$models" ] || die "loken returned no catalogue at $LOKEN_URL/api/tags (is it serving?)"

    local ctxs prompts streams devices
    if [ "${FULL:-0}" = 1 ]; then
        # The full matrix axes come from the manifest - the only curated data a campaign reads.
        IFS='|' read -r ctxs prompts streams devices < <(python3 - "$MATRIX" <<'PY'
import sys, tomllib
a = tomllib.load(open(sys.argv[1], "rb"))["axes"]
print(" ".join(str(c) for c in a["context"]) + "|"
      + " ".join(a["prompts"]) + "|"
      + " ".join("1" if s else "0" for s in a["stream"]) + "|"
      + " ".join(a["device"]))
PY
)
    else
        ctxs="4096"; prompts="short"; streams="1"; devices="gpu"
    fi
    # A card is measured through one backend; the host has none to choose.
    [ "$BACKEND" = native ] || devices="gpu"
    local stamp; stamp=$(stat -c %Y "$LOKEN_BIN")

    cd "$ROOT" || die "cannot cd $ROOT"
    # The thermal floor, read once for the whole campaign while nothing works on the cards and
    # exported to every cell: read per cell, on cards still warm from the cell before, the gate
    # would open on a reading that means nothing.
    if [ "$GPU_VENDOR" != amd ] && have nvidia-smi && [ -z "${GPU_IDLE_C:-}" ]; then
        local busy held
        busy=$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits | sort -rn | head -1)
        held=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits | sort -rn | head -1)
        if [ "${busy:-0}" -gt 5 ] || [ "${held:-0}" -gt 600 ]; then
            die "cards are still working (${busy}% busy, ${held} MiB held): stop what holds them first"
        fi
    fi
    if [ "$GPU_VENDOR" != nvidia ]; then
        local card busy_amd
        for card in /sys/bus/pci/devices/*; do
            [ "$(cat "$card/vendor" 2>/dev/null)" = 0x1002 ] || continue
            busy_amd=$(cat "$card/gpu_busy_percent" 2>/dev/null || echo 0)
            [ "$busy_amd" -le 5 ] || die "an AMD card is still working (${busy_amd}% busy): stop what holds it first"
        done
    fi
    if [ -z "${GPU_IDLE_C:-}" ]; then
        GPU_IDLE_C="$(
            {
                nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null
                for card in /sys/bus/pci/devices/*; do
                    [ "$(cat "$card/vendor" 2>/dev/null)" = 0x1002 ] || continue
                    for t in "$card"/hwmon/hwmon*/temp1_input; do [ -r "$t" ] && echo $(( $(cat "$t") / 1000 )); done
                done
            } | sort -rn | head -1
        )"
        if [ -n "$GPU_IDLE_C" ]; then
            export GPU_IDLE_C
            echo "thermal floor for this campaign: ${GPU_IDLE_C}C (idle, nothing resident)"
        fi
    fi

    local m mod fmt engines amod vserve err ctx st pr dev out tag mode psuf suffix asrargs rc declared
    local first=1 missing=0
    # The other nodes of a cluster, if bench.toml names any, as --node arguments.
    local node_args=() node
    while read -r node; do
        [ -n "$node" ] && node_args+=(--node "$node")
    done < <(cluster_nodes)
    for dev in $devices; do for ctx in $ctxs; do for pr in $prompts; do for st in $streams; do
        # The CPU sweeps are streamed only.
        [ "$dev" = cpu ] && [ "$st" != 1 ] && continue
        echo "########## ${dev^^} ctx=$ctx prompts=$pr stream=$st"
        while IFS=$'\t' read -r m mod fmt; do
            [ -n "$m" ] || continue
            if [ -n "${BENCH_ONLY:-}" ] && ! [[ " $BENCH_ONLY " == *" $m "* ]]; then continue; fi
            IFS='|' read -r engines amod vserve err < <(plan_cell "$m" "$mod" "$fmt")
            tag=$(echo "$m" | tr ':/' '__')
            # A model loken lists but the campaign cannot measure is an ERROR cell, visible in
            # the report - never a silent skip. Written once, in the first sweep.
            if [ -n "$err" ]; then
                if [ "$first" = 1 ]; then
                    out="results/${tag}_error.json"
                    write_error_cell "$m" "$err" "$out" "$stamp"
                    echo "ERROR cell: $m ($mod) - $err"
                fi
                continue
            fi
            # Text and vision sweep every axis; a generated-media cell has none and is
            # measured in the first sweep only.
            case "$mod" in
                text|vision) ;;
                *) [ "$first" = 1 ] || continue ;;
            esac
            # vLLM serves on GPUs only.
            if [ "$dev" = cpu ]; then
                engines=$(echo " $engines " | sed 's/ vllm / /; s/^ //; s/ $//'); vserve=""
                [ -n "$engines" ] || continue
            fi
            # A context above the window the model declares is not measured.
            case "$mod" in
                text|vision)
                    declared="$(model_context "$m")"
                    if [ -n "$declared" ] && [ "$ctx" -gt "$declared" ]; then
                        echo "skipped $m ctx=$ctx: the model declares a window of $declared"; continue
                    fi ;;
            esac
            mode=stream; [ "$st" = 1 ] || mode=non-stream
            psuf=""; [ "$pr" != short ] && psuf="_$pr"
            suffix=""; [ "$dev" = cpu ] && suffix="_cpu"
            [ "$BACKEND" = native ] || suffix="_$BACKEND"
            out="results/${tag}_${ctx}_${mode}${psuf}${suffix}.json"
            # Resume: keep a cell only if measured by this binary AND the current engine versions.
            if [ -s "$out" ] && cell_current "$out" "$stamp"; then
                echo "kept $m ctx=$ctx $pr stream=$st $dev (already measured, versions current)"; continue
            fi
            echo "===== $m ctx=$ctx prompt=$pr stream=$st device=$dev modality=$amod engines=[$engines]"
            asrargs=()
            if [ "$amod" = asr ]; then
                asrargs=(--audio "$ASR_AUDIO")
                [ -s "$ASR_REFERENCE" ] && asrargs+=(--reference "$(cat "$ASR_REFERENCE")")
            fi
            # Measured into a file of its own: a run that writes nothing leaves no earlier result
            # to be stamped with this build.
            rm -f "$out.part"
            env ENGINES="$engines" STREAM="$st" BENCH_MODE="$dev" OUT="$out.part" VLLM_SERVE="$vserve" \
                GPU_PIN="$([ "$dev" = gpu ] && echo "${PIN:-}")" ASR_AUDIO="$ASR_AUDIO" \
                timeout --kill-after=60 "${CELL_CAP:-7200}" \
                scripts/engines/fair-run.sh --models "$m" --prompts "$pr" --num-ctx "$ctx" \
                --max-tokens "${MAXTOK:-128}" --iterations 3 --modality "$amod" \
                "${asrargs[@]}" \
                2>&1 | tail -4
            rc=${PIPESTATUS[0]}
            if [ "$rc" = 124 ] || [ "$rc" = 137 ]; then
                echo "cell interrupted after ${CELL_CAP:-7200}s: $m ctx=$ctx $pr stream=$st $dev"
            fi
            [ -s "$out.part" ] || { echo "no result for $m"; missing=$((missing + 1)); continue; }
            mv "$out.part" "$out"
            stamp_result "$out" "$stamp"
            python3 scripts/architecture.py enrich "$out" "${node_args[@]}" \
                || echo "  (the architecture of $m was not added to $out)"
            python3 scripts/add.py "$out" >/dev/null 2>&1 || echo "  (the record of $m was not filed: run scripts/add.py $out)"
            # The score follows every cell, so a regression shows while the campaign still runs.
            python3 scripts/scoreboard.py results --brief 2>/dev/null || true
        done <<< "$models"
        first=0
    done; done; done; done
    if [ "$missing" -gt 0 ]; then
        echo "campaign incomplete: $missing cell(s) without a result"
    fi
    echo "campaign done"
}

case "${1:---plan}" in
    --plan|plan|"") plan ;;
    run) run ;;
    *) die "unknown argument: $1 (try --plan or run)" ;;
esac
